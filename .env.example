# Local, per-install values. Copy to .env (git-ignored) and fill in.
# Read by apply-hermes-config.py and make-config.sh.

# WhatsApp group JID that Hermes delivers ring replies to (digits@g.us)
HERMES_DELIVER_CHAT_ID=100000000000000000@g.us

# Group JID for the instant "Heard" ack (leave empty to disable)
ACK_CHAT_ID=

# Where secrets.env lives (default: next to apply-hermes-config.py)
# INDEX01_SECRETS_FILE=/path/to/index01-adapter/secrets.env

# Optional overrides for where routing.yaml is read from
# PEBBLE_ROUTING_FILE=/path/to/routing.yaml
# WA_ROUTING_FILE=/path/to/routing.yaml
